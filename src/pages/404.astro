---
import Layout from '../layouts/Layout.astro';

/**
 * Astro only emits `404.html` when this file exists, and the Cloudflare Worker
 * serving `dist/` is configured with `not_found_handling: "404-page"` — without
 * it, an unknown path returns a bare, unbranded 404 from the edge.
 */
---

<Layout title="Page not found" description="That page does not exist." noindex={true}>
  <section class="section not-found">
    <p class="kicker">404</p>
    <h1 class="h1">We could not find that page</h1>
    <p class="lead not-found-lead">
      The link may be out of date, or the page may have moved. The kits and the teacher resources
      are both a click away.
    </p>

    <div class="cta-actions not-found-actions">
      <a class="btn-solid" href="/kits">
        Browse the kits
      </a>
      <a class="btn-secondary" href="/">
        Back to home
      </a>
    </div>

    <p class="muted not-found-help">
      Looking for something specific? <a href="/contact">Get in touch</a> and we will point you to
      it.
    </p>
  </section>
</Layout>

<style>
  .not-found {
    text-align: center;
    max-width: 60ch;
    margin-inline: auto;
    padding-block: 3rem 4rem;
  }

  .not-found-lead {
    margin: 0.85rem auto 0;
  }

  .not-found-actions {
    margin-top: 1.75rem;
  }

  .not-found-help {
    margin-top: 2rem;
    font-size: 0.92rem;
  }
</style>
