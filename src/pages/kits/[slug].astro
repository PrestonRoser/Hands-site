---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import BuyButton from '../../components/BuyButton.astro';
import WhyWorks from '../../components/WhyWorks.astro';
import FAQList from '../../components/FAQList.astro';
import Trust from '../../components/Trust.astro';
import { listKits, listLessonsForKit, formatPrice, formatRange, statusLabel } from '../../lib/catalog';
import { site, features, platformUrl } from '../../lib/site';

export async function getStaticPaths() {
  const kits = await listKits();
  return kits.map((kit) => ({ params: { slug: kit.slug }, props: { kit } }));
}

const { kit } = Astro.props;
const lessons = await listLessonsForKit(kit.slug);

const hero = kit.images[0];
const gallery = kit.images.slice(1);
const price = formatPrice(kit.price);
const duration = formatRange(kit.activityMinutes, 'minutes');
const groupSize = formatRange(kit.groupSize, 'students');
const purchasable = kit.status === 'available' || kit.status === 'preorder';

const productLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: kit.name,
  description: kit.summary,
  sku: kit.sku,
  brand: { '@type': 'Brand', name: site.name },
  url: new URL(kit.href, site.url).href,
};

// Only emit an Offer when there is a real price to state — an Offer without a
// price is invalid structured data, and the price currently lives on Etsy.
if (kit.price?.amount != null) {
  productLd.offers = {
    '@type': 'Offer',
    price: kit.price.amount,
    priceCurrency: kit.price.currency,
    availability:
      kit.status === 'available'
        ? 'https://schema.org/InStock'
        : 'https://schema.org/PreOrder',
    url: kit.purchase.etsyUrl ?? new URL(kit.href, site.url).href,
  };
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Kits', item: new URL('/kits', site.url).href },
    { '@type': 'ListItem', position: 2, name: kit.name, item: new URL(kit.href, site.url).href },
  ],
};
---

<Layout
  title={kit.name}
  description={kit.summary}
  type="product"
  jsonLd={[productLd, breadcrumbLd]}
  contained={false}
>
  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/kits">Kits</a></li>
          <li aria-current="page">{kit.name}</li>
        </ol>
      </nav>

      <div class="pdp-top">
        <div class="pdp-media">
          {
            hero &&
              (typeof hero.src === 'string' ? (
                <img src={hero.src} alt={hero.alt} class="hero-img" />
              ) : (
                <Image
                  src={hero.src}
                  alt={hero.alt}
                  class="hero-img"
                  width={1024}
                  widths={[480, 768, 1024]}
                  sizes="(min-width: 960px) 560px, 94vw"
                  loading="eager"
                  fetchpriority="high"
                />
              ))
          }

          {
            gallery.length > 0 && (
              <ul class="thumbs">
                {gallery.map((img) => (
                  <li>
                    {typeof img.src === 'string' ? (
                      <img src={img.src} alt={img.alt} loading="lazy" />
                    ) : (
                      <Image
                        src={img.src}
                        alt={img.alt}
                        width={640}
                        widths={[320, 640]}
                        sizes="(min-width: 640px) 320px, 220px"
                        loading="lazy"
                      />
                    )}
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="pdp-buy">
          <p class="kicker">{kit.subjects.join(' · ')}</p>
          <h1 class="h1">{kit.name}</h1>
          <p class="pdp-tagline">{kit.tagline}</p>
          <p class="lead">{kit.summary}</p>

          <div class="pdp-badges">
            <span
              class:list={[
                'badge',
                kit.status === 'available' ? 'badge-available' : 'badge-dev',
              ]}
            >
              {statusLabel(kit.status)}
            </span>
            {kit.gradeBands.map((g) => <span class="badge">{g}</span>)}
            {kit.ageMin && <span class="badge">Ages {kit.ageMin}+</span>}
          </div>

          <p class="pdp-price">{price ?? (purchasable ? 'See current price on Etsy' : 'Not yet available')}</p>

          <BuyButton kit={kit} />

          <dl class="pdp-facts">
            {
              duration && (
                <div>
                  <dt>Activity length</dt>
                  <dd>{duration}</dd>
                </div>
              )
            }
            {
              groupSize && (
                <div>
                  <dt>Works well for</dt>
                  <dd>{groupSize} per kit</dd>
                </div>
              )
            }
            {
              kit.standards.length > 0 && (
                <div>
                  <dt>Designed to support</dt>
                  <dd>{kit.standards.join(', ')}</dd>
                </div>
              )
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  {
    (kit.audience.length > 0 || kit.teaches.length > 0) && (
      <section class="section band" style="padding-block:2.5rem">
        <div class="container">
          <div class="grid-2-even" style="align-items:start;gap:2rem">
            {kit.audience.length > 0 && (
              <div>
                <h2 class="h2">Who it's for</h2>
                <ul class="bullet-list muted">
                  {kit.audience.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              </div>
            )}
            <WhyWorks variant="inline" />
          </div>
        </div>
      </section>
    )
  }

  {
    kit.teaches.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="h2">What the kit teaches</h2>
          <div class="feature-grid" style="margin-top:1rem">
            {kit.teaches.map((t) => (
              <div class="pill">
                <strong>{t.term}</strong>
                <span>{t.detail}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    lessons.length > 0 && (
      <section class="section" style="padding-top:0">
        <div class="container">
          <h2 class="h2">Included learning</h2>
          <p class="muted lessons-intro">
            {lessons.length} sequenced lessons ship with this kit, each with learning
            goals, a guided activity, practice exercises, and reflection questions.
            {features.platform.enabled
              ? ' Materials unlock on the HANDS platform with your school licence.'
              : ' Materials are delivered with your order.'}
          </p>

          <ol class="lesson-list">
            {lessons.map((lesson, i) => (
              <li class="lesson card">
                <span class="lesson-num" aria-hidden="true">
                  {i + 1}
                </span>
                <div class="lesson-body">
                  <h3 class="h3">
                    {lesson.title}
                    {lesson.advanced && <span class="badge lesson-adv">Advanced</span>}
                  </h3>
                  <p class="muted lesson-summary">{lesson.summary}</p>
                  {lesson.outcomes.length > 0 && (
                    <details class="lesson-outcomes">
                      <summary>Learning outcomes</summary>
                      <ul class="bullet-list muted">
                        {lesson.outcomes.map((o) => (
                          <li>{o}</li>
                        ))}
                      </ul>
                    </details>
                  )}
                </div>
              </li>
            ))}
          </ol>

          {features.platform.enabled && (
            <p class="lessons-platform">
              <a class="btn-secondary" href={platformUrl(features.platform.redeemPath)}>
                Already have a code? Register your school
              </a>
            </p>
          )}
        </div>
      </section>
    )
  }

  {
    kit.deepDive.length > 0 && (
      <section class="section" style="padding-top:0">
        <div class="container">
          <h2 class="h2">In the classroom</h2>
          <div class="deep-dive">
            {kit.deepDive.map((block) => (
              <div class="deep-block">
                <div class:list={['pastel-hr', block.accent]} />
                <h3 class="h3">{block.title}</h3>
                <p class="lead deep-body">{block.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    (kit.includes.length > 0 || kit.materials.length > 0) && (
      <section class="section band" style="padding-block:2.5rem">
        <div class="container">
          <div class="grid-2-even" style="align-items:start;gap:2rem">
            {kit.includes.length > 0 && (
              <div>
                <h2 class="h2">What's in the box</h2>
                <ul class="bullet-list muted">
                  {kit.includes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
            {kit.materials.length > 0 && (
              <div>
                <h2 class="h2">Materials and care</h2>
                <ul class="bullet-list muted">
                  {kit.materials.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    kit.learningOutcomes.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="grid-2-even" style="align-items:start;gap:2rem">
            <div>
              <h2 class="h2">Learning outcomes</h2>
              <ul class="bullet-list">
                {kit.learningOutcomes.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
            </div>
            <div>
              <h2 class="h2">Common questions</h2>
              <FAQList mode="compact" />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section" style="padding-top:0">
    <div class="container">
      <Trust />
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="cta-band">
        <p class="cta-title">Bring {kit.name} to your classroom</p>
        <p class="cta-subtext">
          Order a single kit, or talk to us about classroom bundles and pilots.
        </p>
        <BuyButton kit={kit} align="center" showNote={false} />
      </div>
    </div>
  </section>

  {
    purchasable && (
      <div class="sticky-buy">
        <div class="container sticky-inner">
          <span class="sticky-name">{kit.name}</span>
          <BuyButton kit={kit} showQuote={false} showNote={false} />
        </div>
      </div>
    )
  }
</Layout>

<style>
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    padding: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.4rem;
    color: var(--border);
  }

  .crumbs a {
    color: var(--brand-dark);
  }

  .pdp-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .pdp-top {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3rem;
    }
  }

  /* Justified gallery: every thumbnail is the same height and takes whatever
     width its aspect ratio needs. A fixed-width thumb made landscape shots
     render tiny with dead space while portrait shots filled the frame. */
  .thumbs {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.9rem 0 0;
    padding: 0;
  }

  .thumbs li {
    flex: 0 0 auto;
    height: 150px;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: #fafbff;
    display: flex;
  }

  @media (min-width: 640px) {
    .thumbs li {
      height: 210px;
    }
  }

  .thumbs :global(img) {
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: cover;
    display: block;
  }

  .pdp-tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--brand-dark);
    margin: 0.5rem 0 0.75rem;
  }

  .pdp-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0;
  }

  .pdp-price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    margin: 0 0 0.9rem;
  }

  .pdp-facts {
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 0.6rem;
    font-size: 0.92rem;
  }

  .pdp-facts div {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pdp-facts dt {
    color: var(--muted);
    margin: 0;
    min-width: 9rem;
  }

  .pdp-facts dd {
    margin: 0;
    font-weight: 600;
  }

  .lessons-intro {
    max-width: 68ch;
    margin: 0.4rem 0 1.5rem;
  }

  .lesson-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .lesson {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem;
  }

  .lesson-num {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background: var(--brand-tint);
    color: var(--brand-dark);
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
  }

  .lesson-body {
    min-width: 0;
  }

  .lesson-body .h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .lesson-adv {
    font-size: 0.7rem;
  }

  .lesson-summary {
    margin: 0.35rem 0 0;
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .lesson-outcomes {
    margin-top: 0.6rem;
  }

  .lesson-outcomes summary {
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--brand-dark);
  }

  .lessons-platform {
    margin-top: 1.25rem;
  }

  .deep-dive {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 860px) {
    .deep-dive {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 2.5rem;
    }
  }

  .deep-body {
    margin: 0.4rem 0 0;
    font-size: 1rem;
  }

  /* Sticky purchase bar on small screens only. Keeps the primary action
     reachable without covering focus targets on desktop. */
  .sticky-buy {
    position: sticky;
    bottom: 0;
    z-index: 30;
    background: rgba(255, 255, 255, 0.95);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--border);
    padding: 0.7rem 0;
  }

  @media (min-width: 768px) {
    .sticky-buy {
      display: none;
    }
  }

  .sticky-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .sticky-name {
    font-weight: 700;
    font-size: 0.9rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
