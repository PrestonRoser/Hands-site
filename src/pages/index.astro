---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import IntentRouter from '../components/IntentRouter.astro';
import WhyHands from '../components/WhyHands.astro';
import FeaturedKit from '../components/FeaturedKit.astro';
import TrustRow from '../components/TrustRow.astro';
import HomeCTA from '../components/HomeCTA.astro';
import { site } from '../lib/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    logo: new URL(site.logo, site.url).href,
    description: site.description,
    sameAs: ['https://www.instagram.com/hand.slearning/'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
  },
];
---

<Layout
  title="HANDS — Hands-on STEM kits for K-12 classrooms"
  description={site.description}
  brandSuffix={false}
  jsonLd={jsonLd}
  contained={false}
>
  <HomeHero />
  <IntentRouter />
  <WhyHands />
  <FeaturedKit />
  <TrustRow />
  <HomeCTA />
</Layout>
