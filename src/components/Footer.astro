---
import { site, contact, channels, features, platformUrl } from '../lib/site';

/**
 * The footer carries the full site map. Because the header groups pages into four
 * destinations, every page must remain reachable from here in one click.
 */

const year = new Date().getFullYear();

const COLUMNS = [
  {
    title: 'Kits',
    links: [
      { href: '/kits', label: 'All kits' },
      { href: '/kits/dna-rna-assembly-kit', label: 'DNA & RNA Assembly Kit' },
      { href: '/contact?topic=quote', label: 'Request a quote' },
    ],
  },
  {
    title: 'Educators',
    links: [
      { href: '/educators', label: 'For educators' },
      { href: '/contact?topic=pilot', label: 'Pilot program' },
      { href: '/faq', label: 'FAQ' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/research', label: 'Research' },
      { href: '/venture', label: 'Venture updates' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/mission', label: 'Mission' },
      { href: '/founders', label: 'Founders' },
      { href: '/contact', label: 'Contact' },
    ],
  },
];
---

<footer class="footer-root">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="brandline">
          <img src={site.logo} alt="" width="22" height="22" class="brand-logo" decoding="async" />
          <strong class="brand">{site.name}</strong>
        </div>
        <p class="muted footer-blurb">{site.tagline}</p>

        <div class="footer-contact-actions">
          <a class="btn-ghost focus-ring" href={`mailto:${contact.email}`}>
            <img src="/images/email.svg" alt="" width="18" height="18" loading="lazy" />
            <span>{contact.email}</span>
          </a>
          <a class="btn-ghost focus-ring" href={contact.instagram} target="_blank" rel="noopener">
            <img src="/images/instagram.svg" alt="" width="18" height="18" loading="lazy" />
            <span>{contact.instagramHandle}</span>
          </a>
          <a class="btn-ghost focus-ring" href={channels.etsyStore} target="_blank" rel="noopener">
            <img src="/images/cart.svg" alt="" width="18" height="18" loading="lazy" />
            <span>Etsy storefront</span>
          </a>
        </div>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        {COLUMNS.map((col) => (
          <div class="footer-col">
            <p class="footer-col-title">{col.title}</p>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        {features.platform.enabled && (
          <div class="footer-col">
            <p class="footer-col-title">Platform</p>
            <ul>
              <li>
                <a href={platformUrl(features.platform.signInPath)}>Sign in</a>
              </li>
              <li>
                <a href={platformUrl(features.platform.redeemPath)}>Redeem a code</a>
              </li>
            </ul>
          </div>
        )}
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="muted">
        © {year} {site.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-root {
    background: var(--bg);
    border-top: 1px solid rgba(202, 210, 220, 0.8);
    margin-top: 3rem;
  }

  .footer-inner {
    padding-block: 2.5rem 1.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 3rem;
    }
  }

  .brandline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-logo {
    border-radius: 0.5rem;
    box-shadow: 0 0 0 1px rgba(31, 75, 184, 0.08);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--brand-interactive);
    font-size: 1.05rem;
  }

  .footer-blurb {
    margin: 0.5rem 0 1rem;
    font-size: 0.92rem;
    max-width: 34ch;
  }

  .footer-contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .footer-contact-actions .btn-ghost {
    padding: 0.4rem 0.55rem;
    font-size: 0.9rem;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .footer-nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .footer-col-title {
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    margin: 0 0 0.6rem;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .footer-col a {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .footer-col a:hover {
    color: var(--brand-interactive);
  }

  .footer-bottom {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.85rem;
  }
</style>
