---
interface Props {
  mode?: 'compact' | 'full';
  /** Show the filter box. Only meaningful in `full` mode. */
  search?: boolean;
}

const { mode = 'compact', search = false } = Astro.props;

// Core questions reused across pages.
const common = [
  {
    q: 'Does the kit support RNA activities?',
    a: 'Yes. Uracil pieces are included for A–U pairing and single-strand activities.',
  },
  {
    q: 'Is there a teachers’ guide?',
    a: 'Yes. Downloadable lesson plans, worksheets, and answer guides are included.',
  },
  {
    q: 'What age range is this for?',
    a: 'Recommended for ages 10+ (small parts). Perfect for middle to high-school biology.',
  },
];

const sections = [
  {
    title: 'Kit & activities',
    items: [
      {
        q: 'What’s the difference between DNA and RNA in the kit?',
        a: 'DNA uses thymine (T) while RNA uses uracil (U). The kit includes both, so you can swap T→U to model transcription.',
      },
      {
        q: 'Do the colours have specific meanings?',
        a: 'Yes. Bases are colour-coded (A, T, C, G, U, 5-mC) and connect to the beige backbone via orange phosphate links.',
      },
      ...common,
      {
        q: 'How many students can use one kit?',
        a: 'One kit works well for pairs or small groups (2–4 students). Multiple kits scale to larger classes.',
      },
      {
        q: 'Is any wet lab work required?',
        a: 'No. This is a clean, dry, 3-D model designed purely for conceptual learning.',
      },
    ],
  },
  {
    title: 'Ordering & pricing',
    items: [
      {
        q: 'Do you offer educator pricing?',
        a: 'Yes. Classroom bundles and educator pricing are available — contact us and we’ll tailor a quote.',
      },
      {
        q: 'Can you work with purchase orders (POs) or W-9s?',
        a: 'Yes. We can provide a W-9 and accept POs from schools and districts.',
      },
      {
        q: 'Do you sell replacement pieces?',
        a: 'Yes. Contact us for small replacement packs (bases, backbones, jigs).',
      },
    ],
  },
  {
    title: 'Shipping & materials',
    items: [
      {
        q: 'How fast is shipping?',
        a: 'Small batches ship quickly; larger classroom sets may require additional lead time.',
      },
      {
        q: 'What are the materials?',
        a: 'Pieces are 3D-printed in durable PLA; colours are chosen for clarity and contrast.',
      },
      {
        q: 'Is the kit washable?',
        a: 'Yes. Wipe clean with mild soap and water; avoid high heat that can warp PLA.',
      },
    ],
  },
];

const totalCount = sections.reduce((n, s) => n + s.items.length, 0);
const searchText = (q: string, a: string) => `${q} ${a}`.toLowerCase();
---

{
  mode === 'compact' ? (
    <div class="faq-panel">
      {common.map((item) => (
        <details class="faq-row">
          <summary>
            <span class="faq-q">{item.q}</span>
            <svg class="faq-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          <p class="faq-a">{item.a}</p>
        </details>
      ))}
      <p class="faq-all">
        <a class="btn-link" href="/faq">See all FAQs</a>
      </p>
    </div>
  ) : (
    <div class="faq-full">
      {search && (
        <div class="faq-search">
          <label class="faq-search-label" for="faq-search">
            Search questions
          </label>
          <div class="faq-search-field">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="M20 20l-3.5-3.5" />
            </svg>
            <input
              id="faq-search"
              type="search"
              class="faq-search-input"
              placeholder="Try “purchase order” or “ages”"
              autocomplete="off"
              data-total={totalCount}
            />
          </div>
          <p class="faq-count muted" id="faq-count" aria-live="polite">
            {totalCount} questions
          </p>
        </div>
      )}

      {sections.map((section) => (
        <section class="faq-section" data-faq-section>
          <h2 class="faq-section-title">{section.title}</h2>
          <div class="faq-panel">
            {section.items.map((item) => (
              <details class="faq-row" data-faq-item data-faq-text={searchText(item.q, item.a)}>
                <summary>
                  <span class="faq-q">{item.q}</span>
                  <svg class="faq-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>
                <p class="faq-a">{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      ))}

      {search && (
        <p class="faq-empty" id="faq-empty" hidden>
          No questions match that search. Try a different word, or
          <a href="/contact"> ask us directly</a>.
        </p>
      )}
    </div>
  )
}

{
  search && mode === 'full' && (
    <script>
      const input = document.getElementById('faq-search') as HTMLInputElement | null;
      const items = Array.from(
        document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]'),
      );
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>('[data-faq-section]'),
      );
      const count = document.getElementById('faq-count');
      const empty = document.getElementById('faq-empty');
      const total = items.length;

      function apply() {
        if (!input) return;
        const q = input.value.trim().toLowerCase();
        let visible = 0;

        for (const item of items) {
          const text = item.dataset.faqText ?? '';
          const match = q === '' || text.includes(q);
          item.hidden = !match;
          // Open matches while searching so the answer is visible; collapse
          // everything again when the query is cleared.
          item.open = q !== '' && match;
          if (match) visible++;
        }

        for (const section of sections) {
          const anyVisible = Array.from(
            section.querySelectorAll<HTMLElement>('[data-faq-item]'),
          ).some((el) => !el.hidden);
          section.hidden = !anyVisible;
        }

        if (count) {
          count.textContent =
            q === ''
              ? `${total} questions`
              : `${visible} of ${total} question${total === 1 ? '' : 's'} match “${input.value.trim()}”`;
        }
        if (empty) empty.hidden = visible !== 0;
      }

      input?.addEventListener('input', apply);
      input?.addEventListener('keydown', (event) => {
        if ((event as KeyboardEvent).key === 'Escape' && input.value !== '') {
          input.value = '';
          apply();
        }
      });
    </script>
  )
}

<style>
  /* A quiet bordered panel with dividers, rather than a stack of shadowed
     cards — closer to how most documentation and support pages present FAQs. */
  .faq-panel {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    overflow: hidden;
  }

  .faq-row + .faq-row {
    border-top: 1px solid var(--border);
  }

  .faq-row summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background-color 0.15s ease;
  }

  .faq-row summary::marker,
  .faq-row summary::-webkit-details-marker {
    display: none;
  }

  .faq-row summary:hover {
    background: #f8faff;
  }

  .faq-row summary:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: -3px;
  }

  .faq-q {
    min-width: 0;
  }

  .faq-chev {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.18s ease;
  }

  .faq-row[open] .faq-chev {
    transform: rotate(180deg);
  }

  .faq-row[open] summary {
    background: #f8faff;
  }

  .faq-a {
    margin: 0;
    padding: 0 1.1rem 1.1rem;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.6;
    max-width: 70ch;
  }

  .faq-all {
    padding: 0.9rem 1.1rem;
    border-top: 1px solid var(--border);
    margin: 0;
    background: #fbfcff;
  }

  /* ---------- full page ---------- */
  .faq-section + .faq-section {
    margin-top: 2.25rem;
  }

  .faq-section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .faq-search {
    margin-bottom: 2rem;
    max-width: 460px;
  }

  .faq-search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .faq-search-field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    padding: 0 0.85rem;
    color: var(--muted);
  }

  .faq-search-field:focus-within {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  .faq-search-input {
    flex: 1;
    border: 0;
    background: transparent;
    padding: 0.7rem 0;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    min-width: 0;
  }

  .faq-search-input:focus {
    outline: none;
  }

  .faq-search-input::-webkit-search-cancel-button {
    cursor: pointer;
  }

  .faq-count {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }

  .faq-empty {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .faq-empty a {
    color: var(--brand-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
