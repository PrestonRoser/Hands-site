---
const PROOF = [
  {
    label: 'Recognition',
    value: 'Venture Devils',
    detail: 'ASU Edson E+I seed funding',
  },
  {
    label: 'Completed pilots',
    value: '8 classrooms',
    detail: "'25–'26, Phoenix, AZ",
  },
  {
    label: 'Etsy reviews',
    value: '★★★★★',
    detail: 'From early classroom orders',
  },
];

const AUDIENCES = ['Middle to high-school biology programs', 'STEM clubs', 'Homeschool'];
---

<section class="section" style="padding-top:0">
  <h2 class="h2 proof-title">Reviews and pilots</h2>

  <div class="stat-grid">
    {PROOF.map((p) => (
      <div class="card proof-card">
        <p class="proof-label muted">{p.label}</p>
        <p class="h3 proof-value">{p.value}</p>
        <p class="proof-detail muted">{p.detail}</p>
      </div>
    ))}
  </div>

  <div class="audiences">
    <span class="muted">Trusted by</span>
    {AUDIENCES.map((a) => (
      <span class="pill audience-pill">{a}</span>
    ))}
  </div>
</section>

<style>
  .proof-title {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .proof-card {
    text-align: center;
    padding: 1.25rem 1rem;
  }

  .proof-label {
    margin: 0;
    font-size: 0.85rem;
  }

  .proof-value {
    margin: 0.3rem 0 0;
  }

  .proof-detail {
    margin: 0.3rem 0 0;
    font-size: 0.88rem;
  }

  .audiences {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .audience-pill {
    font-size: 0.9rem;
  }
</style>
