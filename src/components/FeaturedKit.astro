---
import { Image } from 'astro:assets';
import BuyButton from './BuyButton.astro';
import { getFeaturedKit, listLessonsForKit, formatRange } from '../lib/catalog';

/**
 * Homepage feature band. Reads the featured kit from the catalog rather than
 * hardcoding product copy, so a catalog change is reflected here automatically.
 */

const kit = await getFeaturedKit();
const lessons = kit ? await listLessonsForKit(kit.slug) : [];
const duration = kit ? formatRange(kit.activityMinutes, 'minute') : null;
const image = kit?.images[0];
---

{
  kit && (
    <section class="section band">
      <div class="container feature-layout">
        <div class="feature-media">
          {image &&
            (typeof image.src === 'string' ? (
              <img src={image.src} alt={image.alt} loading="lazy" />
            ) : (
              <Image
                src={image.src}
                alt={image.alt}
                width={860}
                widths={[420, 640, 860]}
                sizes="(min-width: 960px) 460px, 92vw"
                loading="lazy"
              />
            ))}
        </div>

        <div class="feature-copy">
          <p class="kicker">Featured kit</p>
          <h2 class="h2 feature-name">{kit.name}</h2>
          <p class="lead feature-summary">{kit.summary}</p>

          <ul class="bullet-list muted feature-points">
            {duration && <li>Teacher-ready activities, {duration} blocks</li>}
            {kit.standards.length > 0 && <li>Designed to support {kit.standards.join(', ')}</li>}
            {lessons.length > 0 && (
              <li>
                {lessons.length} sequenced lessons with guided activities and reflection questions
              </li>
            )}
          </ul>

          <div class="feature-actions">
            <a class="btn-solid" href={kit.href}>
              View the kit
            </a>
            <a class="btn-secondary" href="/kits">
              All kits
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .feature-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .feature-layout {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3rem;
    }
  }

  .feature-media {
    border: 1px solid var(--border);
    border-radius: 20px;
    background: #fafbff;
    overflow: hidden;
    padding: 1.25rem;
  }

  .feature-media :global(img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .feature-name {
    margin-top: 0.35rem;
  }

  .feature-summary {
    margin: 0.6rem 0 0;
    max-width: 56ch;
  }

  .feature-points {
    margin-top: 1.1rem;
  }

  .feature-actions {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1.6rem;
  }
</style>
