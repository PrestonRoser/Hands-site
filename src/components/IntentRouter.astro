---
/**
 * Routes a visitor by intent immediately below the hero, instead of making them
 * infer which of eight navigation links applies to them.
 */

const PATHS = [
  {
    href: '/educators',
    title: 'Teach with HANDS',
    body: 'Lesson sequences, standards alignment, pilots, and classroom pricing.',
    cta: 'For educators',
  },
  {
    href: '/kits',
    title: 'Shop classroom kits',
    body: 'Durable, reusable kits that ship ready to run in a single class period.',
    cta: 'Browse kits',
  },
  {
    href: '/research',
    title: 'See the evidence',
    body: 'What the research says about active, tactile learning in STEM.',
    cta: 'Read the research',
  },
];
---

<section class="section band band-tint">
  <div class="container">
    <h2 class="h2 router-title">What brings you here?</h2>
    <ul class="router-grid">
      {
        PATHS.map((p) => (
          <li class="card card-hover router-card">
            <a class="router-link" href={p.href}>
              <span class="sr-only">{p.cta}</span>
            </a>
            <h3 class="h3">{p.title}</h3>
            <p class="muted router-body">{p.body}</p>
            <span class="router-cta" aria-hidden="true">
              {p.cta}
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .router-title {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .router-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .router-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .router-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.35rem 1.25rem;
  }

  .router-link {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: 1;
  }

  .router-body {
    font-size: 0.93rem;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .router-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--brand-dark);
    font-weight: 600;
    font-size: 0.92rem;
    margin-top: 0.4rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
