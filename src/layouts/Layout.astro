---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  type?: 'website' | 'article' | 'product';
  /** Appends the brand name to the title. Off for the homepage, which already leads with it. */
  brandSuffix?: boolean;
  /**
   * Wraps the page in the standard 1180px container.
   *
   * Pass `false` on pages that lay out their own sections — needed for any page
   * using full-bleed `.band` sections, since a wrapping container would prevent
   * them from spanning the viewport.
   */
  contained?: boolean;
}

const {
  title,
  description,
  image,
  noindex = false,
  jsonLd = [],
  type = 'website',
  brandSuffix = true,
  contained = true,
} = Astro.props;

const fullTitle = brandSuffix ? `${title} — ${site.name}` : title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" />

    <!-- Self-hosted fonts: preload the two faces used above the fold. -->
    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <SEO
      title={fullTitle}
      description={description}
      image={image}
      noindex={noindex}
      jsonLd={jsonLd}
      type={type}
    />
  </head>
  <body class="min-h-dvh">
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="nav-wrap">
      <Navbar />
    </div>

    <main id="main">
      {
        contained ? (
          <div class="container">
            <slot />
          </div>
        ) : (
          <slot />
        )
      }
    </main>

    <Footer />
  </body>
</html>
